# Copie ce fichier en .env et renseigne ta clé :
#   copy .env.example .env
#
# Sur Render : Environment → YOUTUBE_API_KEY = ta clé AIza…
# Sans cette variable, WatchOut rejoue toujours la même petite banque locale.
YOUTUBE_API_KEY=

# Hot Potato — validation des mots par thème (IA).
# Recommandé GRATUIT : Groq — https://console.groq.com/keys
# Sur Render : Environment → GROQ_API_KEY = gsk_…
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-20b
#
# Alternative payante / autre provider compatible OpenAI :
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
#
# Avec GROQ_API_KEY (ou OPENAI_*) : vérif 100 % IA (pas de lexique).
# Sans aucune clé : lexique local uniquement.

# Origins autorisées pour Socket.IO (séparées par des virgules).
# Par défaut : localhost + domaines Render connus.
# CORS_ORIGINS=https://ton-domaine.onrender.com,http://localhost:3000

# Plafond de salles simultanées
# MAX_ROOMS=200
