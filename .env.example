# Copie ce fichier en .env et renseigne ta clé :
#   copy .env.example .env
#
# Sur Render : Environment → YOUTUBE_API_KEY = ta clé AIza…
# Sans cette variable, WatchOut rejoue toujours la même petite banque locale.
YOUTUBE_API_KEY=

# Origins autorisées pour Socket.IO (séparées par des virgules).
# Par défaut : localhost + domaines Render connus.
# CORS_ORIGINS=https://ton-domaine.onrender.com,http://localhost:3000

# Plafond de salles simultanées
# MAX_ROOMS=200
