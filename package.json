{
  "name": "mot-de-la-fin-online",
  "version": "1.0.0",
  "description": "Mot de la fin — jeu multijoueur en ligne",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "sync-animals": "node scripts/sync-animal-sprites.js",
    "build-size-it-bank": "node scripts/build-size-it-bank.js",
    "fetch-size-it-assets": "node scripts/fetch-size-it-assets.js",
    "audit-size-it-assets": "node scripts/audit-size-it-assets.js",
    "refresh-size-it-assets": "node scripts/fetch-size-it-assets.js --refresh-mismatched",
    "review-size-it-assets": "node scripts/serve-size-it-review.js",
    "apply-size-it-review": "node scripts/apply-size-it-review.js",
    "refetch-size-it-review-bad": "node scripts/refetch-review-bad-from-web.js",
    "rebuild-size-it-bank": "node scripts/fetch-size-it-assets.js && node scripts/build-size-it-bank.js"
