  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "express": "^4.21.2",
    "matter-js": "^0.20.0",
    "poly-decomp": "^0.3.0",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "fzstd": "^0.1.1"
  }
}
